# The repository keeps the minimum: the four scripts, the input data, the
# simulated training set and the figures of the manuscript. Everything else is
# a computed output that the pipeline regenerates.

# ---- LaTeX manuscript and design notes: not published yet ----
paper/
docs/

# ---- Third-party reference paper (Zou et al., arXiv 2607.13113) ----
reference/

# ---- Computed outputs ----
outputs/

# ---- Tabular results: regenerated by the pipeline ----
*.csv

# ---- Simulation set: only the training chunks and their metadata ----
simulations/*
!simulations/sim_*.rds
!simulations/design_meta.rds
!simulations/observed_inputs.rds

# ---- data/: only what the final scripts read ----
data/dextral_im_scaled.rds
data/normal_im_scaled.rds
data/sinestral_im_scaled.rds
data/volcanes_im.rds
data/shapeZona_sp.rds

# ---- Local-only scripts and working copies ----
scripts/05_map_agreement.R
scripts/bk/
*.bak
*.bak_*
*.broken

# ---- Local backups ----
*.BAK_*/
*.PAPER_BAK_*/
*.bak-*

# ---- LaTeX auxiliaries ----
*.aux
*.log
*.blg
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz
*-eps-converted-to.pdf
texput.log

# ---- R ----
.Rhistory
.RData
.Rproj.user/
.Ruserdata

# ---- System / editor ----
.DS_Store
.vscode/
